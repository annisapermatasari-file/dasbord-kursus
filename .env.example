# Salin ke .env lalu isi nilainya. Jangan commit file .env.

# --- Supabase (tabel users: registrasi, login, reset password) ---
# Project Settings > API di dashboard Supabase.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Service role key — hanya dipakai di server (API route). JANGAN diekspos ke browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- MongoDB (koneksi OAuth, activity logs, impact stats, state digest) ---
MONGO_URL=mongodb://localhost:27017
DB_NAME_APP=dashboard_medsos_direktorat

# --- Aplikasi ---
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Keamanan sesi ---
# Kunci acak untuk menandatangani cookie sesi login (mis. `openssl rand -hex 32`).
# WAJIB di produksi. Mengganti nilainya akan mengeluarkan semua user yang sedang login.
SESSION_SECRET=
# Opsional: buat 4 akun demo (kata sandi diketahui publik). Jangan aktifkan di produksi.
SEED_DEMO_USERS=false
# Opsional, hanya untuk development lokal tanpa SMTP: tampilkan kode reset di layar.
ALLOW_DEV_RESET_CODE=false

# --- OAuth media sosial ---
# Kunci acak untuk menandatangani parameter `state` OAuth (mis. `openssl rand -hex 32`).
# Jika kosong, SUPABASE_SERVICE_ROLE_KEY dipakai sebagai cadangan.
OAUTH_STATE_SECRET=

# Meta (Facebook Page + Instagram Business) — developers.facebook.com/apps
# Redirect URI: {NEXT_PUBLIC_BASE_URL}/api/oauth/meta/callback
META_APP_ID=
META_APP_SECRET=
# Opsional, default v25.0
META_GRAPH_VERSION=v25.0

# Google (YouTube Data/Analytics + GA4) — console.cloud.google.com/apis/credentials
# Redirect URI: {NEXT_PUBLIC_BASE_URL}/api/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# TikTok Login Kit — developers.tiktok.com/apps
# Redirect URI: {NEXT_PUBLIC_BASE_URL}/api/oauth/tiktok/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Ayrshare (opsional, alternatif terpadu)
AYRSHARE_API_KEY=
AYRSHARE_DOMAIN=
AYRSHARE_PRIVATE_KEY=
